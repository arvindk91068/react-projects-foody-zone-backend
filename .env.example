# Create safe template
cat > .env.example << 'EOF'
# ⚠️  SECURITY WARNING: NEVER COMMIT REAL CREDENTIALS! ⚠️
# Copy this file to .env and fill with actual values
# Keep .env file local and add to .gitignore

# ========== DATABASE CONFIGURATION ==========

# 🟢 DEVELOPMENT: Local MongoDB
MONGODB_URI=mongodb://localhost:27017/foodyzone

# 🔵 TESTING: Test Database
# MONGODB_URI_TEST=mongodb://localhost:27017/foodyzone_test

# 🚨 PRODUCTION: MongoDB Atlas (USE REAL VALUES ONLY LOCALLY!)
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# ========== SERVER CONFIGURATION ==========
PORT=5000
NODE_ENV=development
HOST=localhost

# ========== SECURITY CONFIGURATION ==========
# Generate using: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # 100 requests per window

# ========== FRONTEND CONFIGURATION ==========
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ========== APPLICATION SETTINGS ==========
APP_NAME=Foody Zone
APP_VERSION=1.0.0
LOG_LEVEL=debug

# ========== TAX & FEES ==========
TAX_RATE=0.08      # 8%
DELIVERY_FEE=2.99
FREE_DELIVERY_MIN=25
EOF